# Copy to .env.local for local development. On Netlify, set these in Site configuration → Environment variables.
# NONE of these may be prefixed with NEXT_PUBLIC_ — they must never reach the browser.

# --- Live data switch ---------------------------------------------------------------
# false = every screen shows its "not connected" state (no mock numbers anywhere).
DATA_ENABLED=false

# --- Supabase (server only) ---------------------------------------------------------
# Read over Supabase REST (PostgREST) with the service key — no pooler / DATABASE_URL needed.
# Project → Settings → API. The service key bypasses RLS: keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Auth.js (shared dashboard passwords) -------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# One password per role. An empty value disables that role. Changing a password signs out its sessions.
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_ADMIN=
DASHBOARD_PASSWORD_FINANCE=
# Required on Netlify: the production URL. Otherwise sign-in redirects to the per-deploy URL and loses the cookie.
AUTH_URL=
