# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
# NONE of these may be prefixed with NEXT_PUBLIC_ — they must never reach the browser.

# --- Live data switch ---------------------------------------------------------------
# Phase 2A ships with live data OFF: every screen shows its "not connected" state.
DATA_ENABLED=false

# --- Database (server only) ---------------------------------------------------------
# Supabase pooler connection string (Project → Connect → Transaction pooler, port 6543).
# All queries run inside READ ONLY transactions (lib/db/readonly.ts).
DATABASE_URL=
# Optional: Supabase root CA certificate (PEM, \n-escaped) to verify TLS.
DATABASE_CA_CERT=

# --- Access -------------------------------------------------------------------------
# open (default): no login, anyone with the URL can view. google: Google sign-in + ALLOWED_EMAILS below.
ACCESS_MODE=open

# --- Auth.js (only used when ACCESS_MODE=google) ------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails and/or @domain entries. Empty = nobody can sign in.
ALLOWED_EMAILS=
# Optional in production on Vercel; needed if running behind a custom host.
AUTH_URL=
